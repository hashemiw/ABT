# Local development only; these are disposable local database credentials.
DATABASE_URL=postgres://abt:abt_local_only@127.0.0.1:5432/abt?sslmode=disable
HTTP_ADDR=:8080
DB_MAX_CONNS=5
DB_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
AI_PROVIDER=mock
ENABLE_REAL_AI_CALLS=false
ALLOW_PAID_AI_CALLS=false
WORKER_CONCURRENCY=1
# Private S3-compatible storage (local SeaweedFS from compose). Development credentials only.
STORAGE_ENDPOINT=http://127.0.0.1:9000
# Host used in signed URLs; the iOS simulator can reach 127.0.0.1, a real device needs this Mac's LAN address.
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=abt-private
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=abtlocal
STORAGE_SECRET_KEY=abtlocal_secret_only
# Local only: let cmd/migrate create the bucket. Production buckets are provisioned out of band.
STORAGE_ENSURE_BUCKET=true
MAX_UPLOAD_BYTES=10485760
STORAGE_PORT=9000
# Reserved for a later milestone; M0 does not read or use these.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
# Compose host ports; internal services always use db:5432 and :8080.
POSTGRES_PORT=5432
API_PORT=8080
